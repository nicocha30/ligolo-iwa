{
  "id": "/",
  "short_name": "Ligolo-IWA",
  "name": "Ligolo-ng",
  "version": "0.1.1",
  "icons": [
    {
      "src": "/ligolo.png",
      "sizes": "500x500",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "start_url": "/",
  "display": "standalone",
  "scope": "/",
  "permissions_policy": {
    "cross-origin-isolated": ["self"],
    "direct-sockets": ["self"],
    "direct-sockets-private": ["self"],
    "local-network": ["self"],
    "loopback-network": ["self"]
  }
}
